{
  "name": "apex-warfare",
  "version": "0.2.0",
  "private": true,
  "description": "Premium single-player 3D vehicle combat PWA — Massive Warfare-style chase-cam, lock-on shooting across realistic warzone maps.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate-data": "node scripts/validate-data.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=apex-warfare --commit-dirty=true"
  },
  "dependencies": {
    "@babylonjs/core": "^7.34.0",
    "@babylonjs/havok": "^1.3.10",
    "@babylonjs/loaders": "^7.34.0",
    "colyseus.js": "^0.16.22",
    "idb": "^8.0.0",
    "nipplejs": "^0.10.2"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^4.106.0"
  }
}
