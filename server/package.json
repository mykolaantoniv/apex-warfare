{
  "name": "apex-warfare-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Colyseus game server for Apex Warfare (real-time PvP + co-op).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.16.0",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.0",
    "colyseus": "^0.16.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "colyseus.js": "^0.16.22",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
